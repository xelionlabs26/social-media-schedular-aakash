# ---------------------------------------------------------------------------------------------
# Social Media Scheduler – environment. Copy to .env and fill in.
# Only the first block is required to run locally; everything else is optional and can be
# added when you connect that service.
# ---------------------------------------------------------------------------------------------

# Required ---------------------------------------------------------------------------------------
DATABASE_URL=postgres://scheduler:scheduler@localhost:5432/scheduler
APP_URL=http://localhost:3000
# Owner login. Create the hash with: pnpm hash-password 'your password'
OWNER_EMAIL=you@example.com
OWNER_PASSWORD_HASH=
# At least 32 random characters: openssl rand -base64 48
AUTH_SECRET=
# 32 random bytes, base64: openssl rand -base64 32  (encrypts platform tokens)
TOKEN_ENC_KEY=

# Storage (local disk by default; use s3 for Cloudflare R2 in production) -----------------------
STORAGE_DRIVER=local
STORAGE_DIR=.data/storage
WORK_DIR=.data/work
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=scheduler-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# AI (Claude) -------------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Only if your key is not scoped to a workspace (Console → Workspaces, ID starts with wrkspc_)
ANTHROPIC_WORKSPACE_ID=
# true = canned captions without calling Claude (for trying the app without a key)
AI_MOCK=false

# Speech-to-text (pick one in Settings; Hindi + English test in M1) -----------------------------
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
SARVAM_API_KEY=
ASSEMBLYAI_API_KEY=

# YouTube (Google Cloud OAuth client, type "Web application") -----------------------------------
# Redirect URI to register: ${APP_URL}/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook Page + Instagram (Meta app, Facebook Login for Business) -----------------------------
# Redirect URI to register: ${APP_URL}/api/oauth/meta/callback
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
GRAPH_VERSION=v27.0

# Alerts ------------------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# RESEND_API_KEY=
# NOTIFY_FROM_EMAIL=alerts@yourdomain.com

# Worker ------------------------------------------------------------------------------------------
# false = never call the platforms' publish APIs (safe dry run)
PUBLISHING_ENABLED=true
